[Unit]
Description=Adaptador MPO Flask app
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/adaptador-mpo
EnvironmentFile=/opt/adaptador-mpo/.env
ExecStart=/opt/adaptador-mpo/.venv/bin/gunicorn --workers=2 --threads=4 --timeout=120 --bind=127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
